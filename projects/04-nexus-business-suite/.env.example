# SQLite database file, relative to the project root (resolved from cwd).
DATABASE_URL="file:./prisma/dev.db"

# Session secret used to sign the demo auth cookie (P04-2).
# Generate one with: openssl rand -hex 32
AUTH_SECRET="dev-only-secret-change-me"

# Mock mode is the default. Set to "live" only with real provider credentials.
NOTIFICATION_TRANSPORT="mock"
