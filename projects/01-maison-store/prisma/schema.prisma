generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// SQLite cannot store enum types, so status and kind fields are plain
// strings validated at the boundary. Money is stored in integer minor units.
datasource db {
  provider = "sqlite"
}

model Collection {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  tagline     String
  description String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  slug           String         @unique
  description    String
  material       String?
  price          Int
  compareAtPrice Int?
  currency       String         @default("USD")
  featured       Boolean        @default(false)
  collectionId   Int
  collection     Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  variants       Variant[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([collectionId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null means "render the generated gradient placeholder" — the demo ships
  // without photography, so no external asset is ever requested.
  url       String?
  alt       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model Variant {
  id        Int        @id @default(autoincrement())
  productId Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  colour    String
  sku       String     @unique
  stock     Int        @default(0)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colour])
  @@index([productId])
}

model Customer {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String
  passwordHash String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  addresses    Address[]
  carts        Cart[]
  orders       Order[]
  wishlist     WishlistItem[]
}

model Address {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String   @default("US")
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

model Cart {
  id         Int        @id @default(autoincrement())
  token      String     @unique
  customerId Int?       @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id                 Int         @id @default(autoincrement())
  orderNumber        String      @unique
  customerId         Int
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             String
  email              String
  subtotal           Int
  discountTotal      Int         @default(0)
  shippingTotal      Int         @default(0)
  total              Int
  currency           String      @default("USD")
  discountCode       String?
  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String
  shippingPostalCode String
  shippingCountry    String      @default("US")
  placedAt           DateTime    @default(now())
  items              OrderItem[]

  @@index([customerId])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    Int?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantLabel String
  quantity     Int
  unitPrice    Int
  lineTotal    Int

  @@index([orderId])
}

model Discount {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String
  kind        String
  value       Int
  minSubtotal Int       @default(0)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}
