# SQLite database file, relative to the project root (resolved from cwd).
DATABASE_URL="file:./prisma/dev.db"

# Payments are mocked in this demo. No provider keys are required or read.
PAYMENT_PROVIDER="mock"

# Signs the HttpOnly account session cookie. Leave empty for the demo: a random
# per-process secret is generated, so sessions end when the server restarts.
# Set a long private value to keep sessions across restarts or outside a demo.
AUTH_SECRET=""
