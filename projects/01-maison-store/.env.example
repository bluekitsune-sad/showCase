# SQLite database file, relative to the project root (resolved from cwd).
DATABASE_URL="file:./prisma/dev.db"

# Payments are mocked in this demo. No provider keys are required or read.
PAYMENT_PROVIDER="mock"

# Signs the HttpOnly account session cookie. The demo falls back to a local
# development value; set a private value anywhere this runs outside a demo.
AUTH_SECRET="maison-demo-session-secret-change-me"
